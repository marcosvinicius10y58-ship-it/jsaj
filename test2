local function startBuddhaLoop()
	if TABLE_TableIndirection["buddhaTask%0"] then
		task.cancel(TABLE_TableIndirection["buddhaTask%0"]);
		TABLE_TableIndirection["buddhaTask%0"] = nil;
	end
	TABLE_TableIndirection["buddhaTask%0"] = task.spawn(function()
		TABLE_TableIndirection["lastCheckTime%0"] = 0;
		while TABLE_TableIndirection["AUTO_BUDDHA_ENABLED%0"] do
			task.wait(1);
			TABLE_TableIndirection["currentTime%0"] = tick();
			if ((TABLE_TableIndirection["currentTime%0"] - TABLE_TableIndirection["lastCheckTime%0"]) >= TABLE_TableIndirection["CHECK_INTERVAL%0"]) then
				TABLE_TableIndirection["lastCheckTime%0"] = TABLE_TableIndirection["currentTime%0"];
				if not TABLE_TableIndirection["LocalPlayer%1"].Character then
				elseif isBuddhaForm() then
					local hasSword, swordName = hasAnySwordEquipped();
					if not hasSword then
						equipSword();
					end
				else
					TABLE_TableIndirection["success%1"] = performBuddhaTransformation();
					if TABLE_TableIndirection["success%1"] then
						task.wait(0.5);
						local hasSword, swordName = hasAnySwordEquipped();
						if not hasSword then
							equipSword();
						end
					end
				end
			end
		end
		TABLE_TableIndirection["buddhaTask%0"] = nil;
	end);
end
